# Copy to .env for local runs. .env is gitignored.

# Point the agent at the REAL, PRIVATE JD-gap corpus. Unset = the public
# synthetic stub (data/jd-gaps.stub.yaml). The real file must live OUTSIDE this
# repo (or in a gitignored path) and is never committed.
#
# A relative path is resolved against the repo root, so this works from anywhere
# (keep the real corpus in a sibling repo, outside this one):
# LTS_CORPUS_PATH=../private-corpus/jd-gaps.real.yaml

# Point recall's --today / --journal at your Logseq vault — the folder that
# contains journals/. Reads only — except the propose inbox below.
# LTS_VAULT_PATH=/Users/you/Logseq/MyVault

# The vault page holding YOUR triaged study queue, for `rank --queue`.
# Unset = Learning/Queue. The agent reads it; triage stays yours.
# LTS_QUEUE_PAGE=Learning/Queue

# Where `propose --write` delivers drafts for YOUR triage — the only vault
# page the agent ever writes (append-only). Unset = Learning/inbox/propose.
# LTS_PROPOSE_INBOX_PAGE=Learning/inbox/propose

# LLM for recall's content checks and propose's drafts (rank never uses one).
# DeepSeek first for cheap testing; switch providers with one line (Q8).
# auto (default) prefers DeepSeek when its key is set, else Anthropic.
# DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LTS_LLM_PROVIDER=auto          # auto | deepseek | anthropic
# LTS_LLM_MODEL=deepseek-chat    # optional model override
